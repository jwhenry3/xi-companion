{
  "name": "xi-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:addon": "tsc --noEmit && vite build --outDir addon/xicompanion/ui --emptyOutDir",
    "build:overlay": "cd overlay/wails && go build -tags production -ldflags \"-s -w -H windowsgui\" -o ../../addon/xicompanion/overlay/xicompanion-overlay.exe .",
    "deploy": "node scripts/deploy.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build:addon && npm run build:overlay && node scripts/package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact-mvc/core": "^0.1.0",
    "@preact/signals": "^1.3.0",
    "@tanstack/query-core": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-preact": "1.59.0",
    "preact": "^10.24.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.19.2",
    "fengari": "0.1.5",
    "jsdom": "^25.0.0",
    "lua-types": "2.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.5.0",
    "typescript-to-lua": "1.26.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
